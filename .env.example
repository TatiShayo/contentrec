# ==============================================================================
# CONTENTREC Recommendation Engine - Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` and configure appropriate values for your environment.

# --- Storage Paths ---
DATABASE_PATH=data/recommender.db
MODEL_PATH=data/model.pkl
FAISS_INDEX_PATH=data/faiss.index
SASREC_MODEL_PATH=data/sasrec_model.pt
SASREC_MAP_PATH=data/sasrec_map.pkl
LIGHTGCN_MODEL_PATH=data/lightgcn.pkl
BCQ_MODEL_PATH=data/bcq.pth

# --- Recommendation Tuning ---
# Minimum user interactions required before switching from cold-start to collaborative model
COLD_START_THRESHOLD=3
# Default number of recommendations returned per request
DEFAULT_N_RECOMMENDATIONS=10
# Maximum allowed recommendations per single request (DoS protection limit)
MAX_N_RECOMMENDATIONS=100
# Maximum items per page in paginated endpoints
MAX_PAGE_LIMIT=500

# --- Retraining Scheduler ---
# Number of new interactions required to trigger background incremental retraining
RETRAIN_THRESHOLD_FEEDBACK=50
# Time interval in seconds between scheduled retraining cycles (86400 = 24h)
RETRAIN_INTERVAL_SECONDS=86400

# --- Linear Fusion Objective Weights ---
WEIGHT_RELEVANCE=1.0
WEIGHT_FRESHNESS=0.2
WEIGHT_FATIGUE=0.3
WEIGHT_CONTEXT=0.4
LATENCY_SLA_ALERT_THRESHOLD_SEC=0.15

# --- Security Configuration ---
# API Key for authenticated endpoints (leave empty for unauthenticated development/tests)
API_KEY=
# Comma-separated list of allowed CORS origins (e.g., "https://example.com,https://app.example.com")
# Set to "*" only if public without credentials
CORS_ALLOW_ORIGINS=

# --- Test Environment Flag ---
TESTING=false
